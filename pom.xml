<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 1. BLOCO PARENT E METADADOS DO PROJETO -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- busca o parent no repositório remoto -->
	</parent>

	<groupId>com.diniz</groupId>
	<artifactId>springboot-webservice-study</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>springboot-webservice-study</name>
	<description>Projeto de estudo Spring Boot WebService</description>

	<!-- 2. BLOCO DE PROPRIEDADES DO PROJETO -->
	<properties>
		<java.version>25</java.version>
	</properties>

	<!-- 3. BLOCO DE DEPENDÊNCIAS DO PROJETO -->
	<dependencies>

		<!-- Módulo Spring Web (Desenvolvimento RESTful e Servidor Web embutido) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Módulo Spring Data JPA (Acesso, persistência e ORM de banco de dados) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Driver do Banco H2 (Banco de dados relacional em memória) -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Driver do Banco PostgreSQL (Driver de conexão para o PostgreSQL) -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Módulo Único de Testes (Agrupa JUnit 5, Mockito e Spring Test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- 4. BLOCO DE CONSTRUÇÃO E PLUGINS -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>